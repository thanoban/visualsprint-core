# Copy to .env.local. Everything defaults sanely for local dev against the
# backend started via `uvicorn app.main:app --reload` — this file only
# matters once the API is running somewhere other than localhost:8000.

# See lib/config.ts. Must be reachable from the browser, not just the
# Next.js server — this is a NEXT_PUBLIC_ var, bundled into client JS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth (lib/supabaseClient.ts, lib/AuthProvider.tsx). The anon key
# is meant to be public -- it's rate-limited and RLS-scoped on Supabase's
# side, not a secret. See docs/EXTERNAL_SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
