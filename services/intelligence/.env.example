INTELLIGENCE_DATABASE_URL=postgres://vs_intelligence_runtime:local-runtime-only@127.0.0.1:55438/intelligence
INTELLIGENCE_MIGRATION_DATABASE_URL=postgres://vs_intelligence_migration:local-migration-only@127.0.0.1:55438/intelligence
ACCOUNT_INTERNAL_URL=http://127.0.0.1:4101
WORKSPACE_INTERNAL_URL=http://127.0.0.1:4102
INGEST_INTERNAL_URL=http://127.0.0.1:4104
PORT=4106
SERVICE_PRIVATE_JWK=
SERVICE_KEY_ID=
GATEWAY_PUBLIC_JWKS=
WORKSPACE_PUBLIC_JWKS=
# Optional managed-identity-only Azure deployment. Missing configuration fails
# generation explicitly; never falls back to a fixture or another vendor.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_CLIENT_ID=
# All paid calls require Account admission plus owning durable dispatch barriers.
INTELLIGENCE_MODEL_ADMISSION_ENABLED=false
INTELLIGENCE_PREPARATION_ENABLED=false
INTELLIGENCE_RETRIEVAL_ENABLED=false
INTELLIGENCE_WORKER_KIND=interactive
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Never enable against original PG55438. Operator-bootstrap vector on a new DB,
# validate roles/restore first, then explicitly run the qualified extended SQL.
INTELLIGENCE_EXTENDED_MIGRATIONS_ENABLED=false
