{
  "name": "@visualsprint/workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "migrations", "specs"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "build": "tsc --outDir dist && node ../../scripts/build-service.mjs",
    "start": "node dist/main.mjs",
    "migrate": "node dist/migrate.mjs",
    "worker": "node dist/worker.mjs",
    "events": "node dist/events.mjs"
  },
  "dependencies": {
    "@visualsprint/messaging": "workspace:*",
    "@azure/service-bus": "7.10.0",
    "@azure/identity": "4.13.3",
    "@visualsprint/contracts": "workspace:*",
    "@visualsprint/platform": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
