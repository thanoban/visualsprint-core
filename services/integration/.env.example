# Supply credentials using process variables or Key Vault references; do not commit filled values.
INTEGRATION_DATABASE_URL=postgres://vs_integration_runtime:local-runtime-only@127.0.0.1:55437/integration
INTEGRATION_MIGRATION_DATABASE_URL=postgres://vs_integration_migration:local-migration-only@127.0.0.1:55437/integration
ACCOUNT_INTERNAL_URL=http://127.0.0.1:4101
# Omit to disable calendar meeting import; trusted server origin, never a client URL.
WORKSPACE_INTERNAL_URL=http://127.0.0.1:4102
SERVICE_PRIVATE_JWK=
SERVICE_KEY_ID=integration-1
GATEWAY_PUBLIC_JWKS=
TOKEN_KEY_ID=integration-v1
# JSON dictionary: key ID -> base64 32-byte AES key; current plus at most two previous keys.
TOKEN_KEYS={}
CALENDAR_REDIRECT_URI=https://your-domain.example/oauth/calendar
# Omit both variables for a disabled provider; never set a secret in VITE_*.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
PORT=4105
