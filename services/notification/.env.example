# Local-only dependencies; use TLS origins, Key Vault and managed identity in Azure.
NOTIFICATION_DATABASE_URL=postgres://vs_notification_runtime:local-runtime-only@127.0.0.1:55441/notification
NOTIFICATION_MIGRATION_URL=postgres://vs_notification_migration:local-migration-only@127.0.0.1:55441/notification
PORT=4109
ACCOUNT_INTERNAL_URL=http://127.0.0.1:4101
WORKSPACE_INTERNAL_URL=http://127.0.0.1:4102
WEB_APP_ORIGIN=http://127.0.0.1:5173
SERVICE_PRIVATE_JWK=
SERVICE_KEY_ID=
GATEWAY_PUBLIC_JWKS=
# Map authoritative event caller names to JWK arrays: {"intelligence":[...],"workflow":[...],"ingest":[...]}
EVENT_SOURCE_PUBLIC_JWKS=
WORKSPACE_PUBLIC_JWKS=
SERVICE_BUS_NAMESPACE=
AZURE_CLIENT_ID=
# Optional; both endpoint/sender must be configured. No resource or send is created at startup.
# AZURE_EMAIL_ENDPOINT=https://your-resource.communication.azure.com
# AZURE_EMAIL_SENDER=donotreply@your-verified-domain.example
ALLOW_LOCAL_EMAIL_AZURE_CLI=false
# Optional metadata-only private invalidation hints. Both API and events process require this pair.
NOTIFICATION_REALTIME_ENABLED=false
# AZURE_WEB_PUBSUB_ENDPOINT=https://your-resource.webpubsub.azure.com
