# Configure via process environment or secret references; never commit populated secrets.
INGEST_DATABASE_URL=postgres://vs_ingest_runtime:local-runtime-only@127.0.0.1:55436/ingest
INGEST_MIGRATION_DATABASE_URL=postgres://vs_ingest_migration:local-migration-only@127.0.0.1:55436/ingest
WORKSPACE_INTERNAL_URL=http://127.0.0.1:4102
ACCOUNT_INTERNAL_URL=http://127.0.0.1:4101
SERVICE_PRIVATE_JWK=
SERVICE_KEY_ID=ingest-1
GATEWAY_PUBLIC_JWKS=
INTEGRATION_PUBLIC_JWKS=
RECALL_API_KEY=
RECALL_REGION=us-west-2
RECALL_WEBHOOK_URL=https://your-domain.example/webhooks/v3/recall
# JSON array: one workspace whsec_ secret; optionally previous secret during rotation.
RECALL_WEBHOOK_SECRETS=[]
PORT=4104
# Separate `events` process; opt-in live Azure transport, not needed for local DB tests.
SERVICE_BUS_NAMESPACE=
AZURE_CLIENT_ID=
