ACCOUNT_DATABASE_URL=postgres://vs_account_runtime:local-runtime-only@127.0.0.1:55434/account
ACCOUNT_MIGRATION_DATABASE_URL=postgres://vs_account_migration:local-migration-only@127.0.0.1:55434/account
DEFAULT_CELL_ID=dev-cell
PORT=4101
WORKOS_CLIENT_ID=
WORKOS_TOKEN_ISSUER=
WORKOS_TOKEN_AUDIENCE=
# Optional server-only key; leave absent until configured in Key Vault. No browser/JWT email claims are used.
# WORKOS_PROFILE_API_KEY=
# Object mapping trusted service names to their public JWK arrays.
SERVICE_TRUSTED_JWKS=
# Explicit capture-bound processing consent. Never reuses calendar grants.
CAPTURE_PROCESSING_ENABLED=false
# Separate paid automatic-extraction admission gate; requires0008 + explicitly approved capture_extraction budget.
# Cleanup of already persisted reservations remains available when disabled.
CAPTURE_MODEL_ADMISSION_ENABLED=false
# Required only when enabled; Account signs metadata-only ownership checks to Ingest.
# INGEST_INTERNAL_URL=http://127.0.0.1:4104
# SERVICE_PRIVATE_JWK=
# SERVICE_KEY_ID=
