# Default-deny build context; only v3 source/manifests/migrations are permitted.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!turbo.json
!apps/
!apps/web/
!apps/web/package.json
!scripts/
!scripts/*.mjs
!packages/
!packages/*/
!packages/*/package.json
!packages/*/tsconfig.json
!packages/*/src/
!packages/*/src/**/
!packages/*/src/**/*.ts
!services/
!services/*/
!services/*/package.json
!services/*/tsconfig.json
!services/*/src/
!services/*/src/**/
!services/*/src/**/*.ts
!services/*/migrations/
!services/*/migrations/*.sql
!services/*/specs/
!services/*/specs/*.sql
