# Copy to .env and fill in what you have. Every field below is optional at
# the Settings level (see app/config.py) — the app runs with none of them
# set, using the docker-compose Postgres and local blob storage. Missing
# vendor/LLM credentials degrade specific pipeline stages honestly (e.g. the
# LLM repair pass and Memory's embedding search skip themselves rather than
# crash) rather than blocking the whole app — see each adapter's docstring
# for its specific fallback behavior.
#
# All vars are prefixed VS_ (SettingsConfigDict(env_prefix="VS_")).

# --- Core ---
VS_ENV=dev
# Matches infra/docker-compose.yml's db service by default — only change
# this if you're running Postgres yourself instead of via docker compose.
VS_DATABASE_URL=postgresql+psycopg://visualsprint:visualsprint_dev@localhost:5433/visualsprint

# --- Blob storage ---
# "local" writes to VS_BLOB_LOCAL_DIR on disk; "s3" targets Cloudflare R2 (or
# any S3-compatible endpoint) using the s3_* vars below.
VS_BLOB_BACKEND=local
VS_BLOB_LOCAL_DIR=.blobstore
# VS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# VS_S3_BUCKET=visualsprint
# VS_S3_ACCESS_KEY_ID=
# VS_S3_SECRET_ACCESS_KEY=

# --- Zoom RTMS (Mode A1 real-time capture; see app/capture/rtms_*.py and
# app/api/rtms_webhook.py) ---
# Zoom Marketplace Server-to-Server OAuth app credentials. This is a
# SEPARATE app from VS_ZOOM_OAUTH_CLIENT_ID below -- S2S apps only grant
# access to your own single Zoom account, they cannot be authorized by a
# customer's account, so they can't be the multi-tenant capture path.
# VS_ZOOM_CLIENT_ID=
# VS_ZOOM_CLIENT_SECRET=
# Validates Zoom's webhook signature (also used to echo back Zoom's
# CRC/URL-validation challenge) — from the same Marketplace app's Feature ->
# Event Subscriptions page.
# VS_ZOOM_WEBHOOK_SECRET_TOKEN=

# --- SecretStore (OAuth token storage; app/interfaces/secretstore.py) ---
# "local" writes plaintext to VS_SECRETSTORE_LOCAL_DIR on disk (dev only);
# "gcp" targets GCP Secret Manager in the same project as VS_VERTEX_PROJECT_ID.
VS_SECRETSTORE_BACKEND=local
VS_SECRETSTORE_LOCAL_DIR=.secretstore

# --- OAuth (per-org vendor connections; app/oauth/) ---
# One app registration per vendor here covers every customer org -- each
# org authorizes it individually via the standard OAuth redirect-consent
# flow from the frontend's "Connect X" buttons. Customers never see or
# paste an API key. VS_OAUTH_REDIRECT_BASE_URL must match what's registered
# as the callback URL with each vendor (e.g. https://api.yourdomain.com in
# prod); the callback path itself is fixed per provider (see app/api/oauth.py).
VS_OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Signs the OAuth state param so a callback can trust which org a grant
# belongs to. Required in any environment serving real traffic -- generate
# with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
# VS_OAUTH_STATE_SECRET=
# Google (Calendar + Meet + Gmail share this one OAuth client).
# VS_GOOGLE_OAUTH_CLIENT_ID=
# VS_GOOGLE_OAUTH_CLIENT_SECRET=
# Slack (channel_recap connector).
# VS_SLACK_OAUTH_CLIENT_ID=
# VS_SLACK_OAUTH_CLIENT_SECRET=
# Jira (task_create connector).
# VS_JIRA_OAUTH_CLIENT_ID=
# VS_JIRA_OAUTH_CLIENT_SECRET=
# GitHub (task_create connector).
# VS_GITHUB_OAUTH_CLIENT_ID=
# VS_GITHUB_OAUTH_CLIENT_SECRET=
# Linear (task_create connector).
# VS_LINEAR_OAUTH_CLIENT_ID=
# VS_LINEAR_OAUTH_CLIENT_SECRET=
# Zoom General App (OAuth) -- NOT the Server-to-Server app above. This is
# what lets a customer authorize VisualSprint against their own Zoom
# account (S2S apps can't do this at all -- see the comment above).
# VS_ZOOM_OAUTH_CLIENT_ID=
# VS_ZOOM_OAUTH_CLIENT_SECRET=
# Microsoft (Calendar + Teams share this one OAuth client; "organizations"
# tenant only -- this product has no use for personal Microsoft accounts).
# VS_MICROSOFT_OAUTH_CLIENT_ID=
# VS_MICROSOFT_OAUTH_CLIENT_SECRET=

# --- ASR vendors (docs/04-asr.md: buy everything, orchestrate the gap) ---
# Google chirp_2 (Sinhala/Tamil primary) — path to a service-account JSON key.
# VS_GOOGLE_CREDENTIALS_JSON=/path/to/service-account.json
# Azure Speech (Sinhala/Tamil fallback).
# VS_AZURE_SPEECH_KEY=
# VS_AZURE_SPEECH_REGION=
# Groq Whisper-v3-turbo (English spans).
# VS_GROQ_API_KEY=
# pyannote diarization pipelines are gated on a HuggingFace account that has
# accepted the model's terms — generate a read token after doing so.
# VS_HUGGINGFACE_TOKEN=
# Set false until the Hugging Face pyannote model terms are accepted and the
# production worker has an intentional memory budget. Transcription still runs
# with unattributed mixed audio.
# VS_DIARIZATION_ENABLED=false

# --- Agents (Claude via Vertex AI by default; Microsoft Foundry is a
# swappable alternate transport behind the same LlmClient interface --
# see app/adapters/llm_vertex.py / llm_foundry.py) ---
VS_LLM_PROVIDER=vertex
# Vertex AI: auth is GCP Application Default Credentials (`gcloud auth
# application-default login`, or a service account in the deploy
# environment) — there is no API key setting for this because
# AnthropicVertex doesn't take one.
# VS_VERTEX_PROJECT_ID=your-gcp-project-id
VS_VERTEX_REGION=us-east5
# Microsoft Foundry (Azure) — only used when VS_LLM_PROVIDER=foundry.
# Create a Foundry resource, deploy the Claude models you need, then copy
# an API key from that resource.
# VS_FOUNDRY_API_KEY=
# VS_FOUNDRY_RESOURCE=
# Per-agent model tier overrides — sensible defaults are already set in
# app/config.py; uncomment only to change one.
# VS_MODEL_EXTRACT=claude-sonnet-5
# VS_MODEL_CLASSIFY=claude-haiku-4-5-20251001
# VS_MODEL_MEMORY=claude-opus-4-8
# VS_MODEL_VERIFY=claude-sonnet-5
# VS_MODEL_REPORT=claude-sonnet-5
# VS_MODEL_REPAIR=claude-haiku-4-5-20251001

# --- Worker ---
VS_WORKER_POLL_SECONDS=2.0
VS_JOB_MAX_ATTEMPTS=5
# How often the worker's periodic sweeps run, in seconds — sensible
# defaults are already set in app/config.py; uncomment only to change one.
# VS_CALENDAR_SYNC_INTERVAL_S=300.0
# VS_RETENTION_SWEEP_INTERVAL_S=3600.0
# VS_TRANSCODE_BACKFILL_INTERVAL_S=3600.0
# VS_ACTION_TRIGGER_INTERVAL_S=300.0
# How far ahead of a commitment's due date to start proposing a reminder
# (also covers already-overdue commitments).
# VS_ACTION_TRIGGER_REMINDER_WINDOW_HOURS=24.0

# --- API ---
# JSON array — pydantic-settings decodes list-typed env vars this way.
VS_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
