{
  "name": "visualsprint-platform",
  "version": "3.0.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "check": "pnpm boundaries && pnpm typecheck && pnpm test && tsc -p tests/tsconfig.json --noEmit",
    "boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "test:integration": "pnpm -r --if-present run test:integration && tsx --test tests/system/*.test.ts"
  },
  "devDependencies": {
    "@visualsprint/platform": "workspace:*",
    "@types/node": "22.18.6",
    "jose": "6.2.12",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "turbo": "2.6.0",
    "typescript": "5.9.3"
  }
}
